# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# Rebrickable API (https://rebrickable.com/api/)
REBRICKABLE_API_KEY=your_rebrickable_api_key

# Brickset API (https://brickset.com/tools/webservices/v3) — popularity labels
BRICKSET_API_KEY=your_brickset_api_key

# Snowflake connection
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=your_account_id
SNOWFLAKE_WAREHOUSE=lego_warehouse
SNOWFLAKE_DATABASE=lego_analytics
SNOWFLAKE_SCHEMA=RAW
